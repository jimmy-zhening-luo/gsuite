{
  "$pkg": "2412.0.0",
  "$schema": "https://json.schemastore.org/package",
  "$help": "https://docs.npmjs.com/cli/configuring-npm/package-json",
  "name": "gsuite",
  "version": "5.3.18",
  "repository": "github:jimmy-zhening-luo/gsuite",
  "description": "Google Apps Script scripts for Google Apps.",
  "keywords": [
    "apps",
    "calendar",
    "gmail",
    "google",
    "google-apps-script",
    "google-calendar",
    "gsuite",
    "script"
  ],
  "license": "MIT",
  "private": true,
  "engineStrict": true,
  "engines": {
    "node": "^24",
    "npm": "^11"
  },
  "type": "module",
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/plugin-transform-runtime": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@google/clasp": "^3.1.3",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/google-apps-script": "^2.0.8",
    "linted": "37.0.3",
    "rollup": "^4.54.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "clean": "cmd --% /c \"for %G in (types dist build packed .svelte-kit) do (if exist %G rmdir /s /q %G) & for %G in (.eslintcache) do (if exist %G del /f /q %G)\" || rm -rf types dist build packed .svelte-kit .eslintcache",
    "build": "rollup --config",
    "postbuild": "npm run lint || exit 0",
    "lint": "eslint --cache --fix",
    "pretest": "npm run build",
    "test": "npm run --if-present test:suite",
    "predeploy": "npm run clean && npm test",
    "stage": "",
    "deploy": "clasp status && clasp push -f && npm run deploy:success",
    "deploy:success": "echo \"Deployed to: https://script.google.com/d/1qFMqBXZquMU9CrUnqjp-TRRtAxtDn24zFiqKID3f7pNzKGD23m38bbze/edit\""
  },
  "author": "Jimmy Zhening Luo <jimmy-zhening-luo@users.noreply.github.com> (https://jimm.my/)"
}
